{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "window_decorations": "client",
  "when_closing_with_no_tabs": "keep_window_open",
  "agent_servers": {},
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_line_height": { "custom": 1.4 },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Kanagawa Wave",
  },
  "icon_theme": "Catppuccin Frappé",
  "indent_guides": {
    "coloring": "indent_aware",
    "active_line_width": 2,
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "entry_spacing": "standard",
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "fish",
        "args": ["--interactive"],
      },
    },
  },
  "lsp": {
    "biome": {
      "settings": {
        "config_path": "<path>/biome.json",
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    "lua-language-server": {
      "binary": {
        "path": "lua-language-server",
      },
    },
  },
  "languages": {
    "HTML": {
      "tab_size": 2,
    },
    "Hern": {
      "tab_size": 2,
    },
    "Nix": {
      "tab_size": 2,
    },
    "JavaScript": {
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.biome" },
        { "code_action": "source.organizeImports.biome" },
      ],
    },
    "TypeScript": {
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.biome" },
        { "code_action": "source.organizeImports.biome" },
      ],
    },
    "TSX": {
      "formatter": [
        { "language_server": { "name": "biome" } },
        { "code_action": "source.fixAll.biome" },
        { "code_action": "source.organizeImports.biome" },
      ],
    },
    "SCSS": {
      "tab_size": 2,
    },
    "Svelte": {
      "tab_size": 2,
    },
    "Jinja2": {
      "tab_size": 2,
    },
    "Fish": {
      "tab_size": 2,
    },
  },

  "ssh_connections": [
    {
      "host": "megumu",
      "projects": [
        {
          "paths": ["/home/kamov/nix"],
        },
      ],
    },
  ],

  "language_models": {
    "openai_compatible": {
      "Hetzner": {
        "api_url": "https://inference.hetzner.com/api/v1",
        "available_models": [
          {
            "name": "Qwen/Qwen3.6-35B-A3B-FP8",
            "display_name": "Hetzner Qwen 3.6 35B",
            "max_tokens": 262144,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
          {
            "name": "Qwen3.8-27B",
            "display_name": "Hetzner Qwen 3.8 27B",
            "max_tokens": 262144,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
  },

  "agent": {
    "default_model": {
      "provider": "Hetzner",
      "model": "Qwen3.8-27B",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
}
