# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  nightly,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "ahci"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];

  boot = {
    kernelPackages = nightly.linuxPackages_latest;
    kernelModules = [ "kvm-amd" ];
    extraModulePackages = [ ];

    loader = {
      systemd-boot.enable = true;
      systemd-boot.configurationLimit = 10;
      systemd-boot.memtest86.enable = true;
      efi.canTouchEfiVariables = true;
    };
  };

  hardware.nvidia = {
    package = nightly.linuxPackages_latest.nvidiaPackages.latest;
    open = true;
    modesetting.enable = true;
    powerManagement.enable = true;
  };

  services.xserver.videoDrivers = [ "nvidia" ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/d61e3f69-be8a-4db4-bdd7-a7bbeae9b7ba";
    fsType = "btrfs";
    options = [
      "noatime"
      "compress=zstd:1"
    ];
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-uuid/d61e3f69-be8a-4db4-bdd7-a7bbeae9b7ba";
    fsType = "btrfs";
    options = [
      "subvol=home"
      "noatime"
      "compress=zstd:1"
    ];
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-uuid/d61e3f69-be8a-4db4-bdd7-a7bbeae9b7ba";
    fsType = "btrfs";
    options = [
      "subvol=nix"
      "noatime"
      "compress=zstd:1"
    ];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/8346-0588";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/data" = {
    device = "/dev/disk/by-uuid/6e9fbbea-d1f6-4618-8088-b8f040ce8b29";
    fsType = "btrfs";
    options = [
      "nofail"
      "x-systemd.device-timeout=5s"
      "noatime"
      "compress=zstd:1"
      "discard=async"
    ];
  };

  services.btrfs.autoScrub = {
    enable = true;
    interval = "monthly";
    fileSystems = [
      "/"
      "/data"
    ];
  };

  services.fstrim.enable = true;

  swapDevices = [
    { device = "/dev/disk/by-uuid/ebc6d29b-4243-47ed-83e5-5c4ab8cf0a1e"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
