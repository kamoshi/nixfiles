{ config, lib, pkgs, ... }:
let
  host = "u654053.your-storagebox.de";
  port = 23;
  user = "u654053";
  location = "${config.home.homeDirectory}/Desktop/tempbox";
  cache = "${config.xdg.cacheHome}/rclone/tempbox";
in
{
  sops.secrets.tempbox-rclone = { };

  home.packages = [
    (pkgs.writeShellApplication {
      name = "tempbox-copy";
      runtimeInputs = [ pkgs.coreutils pkgs.rclone ];
      text = ''
        if (( $# < 2 )); then
          echo "Usage: tempbox-copy SOURCE DESTINATION [RCLONE_OPTIONS...]" >&2
          exit 2
        fi

        source_path=$(realpath "$1")
        destination="''${2#/}"
        shift 2

        # Load the obscured crypt password and salt generated by sops-nix.
        set -a
        # shellcheck disable=SC1091
        source ${lib.escapeShellArg config.sops.secrets.tempbox-rclone.path}
        set +a

        export RCLONE_CONFIG_TEMPBOX_SFTP_TYPE=sftp
        export RCLONE_CONFIG_TEMPBOX_SFTP_HOST=${lib.escapeShellArg host}
        export RCLONE_CONFIG_TEMPBOX_SFTP_USER=${lib.escapeShellArg user}
        export RCLONE_CONFIG_TEMPBOX_SFTP_PORT=${lib.escapeShellArg (toString port)}
        export RCLONE_CONFIG_TEMPBOX_SFTP_KEY_FILE=${lib.escapeShellArg "${config.home.homeDirectory}/.ssh/kamov"}
        export RCLONE_CONFIG_TEMPBOX_SFTP_KNOWN_HOSTS_FILE=${lib.escapeShellArg "${config.home.homeDirectory}/.ssh/tempbox_known_hosts"}
        export RCLONE_CONFIG_TEMPBOX_CRYPT_TYPE=crypt
        export RCLONE_CONFIG_TEMPBOX_CRYPT_REMOTE=tempbox_sftp:crypt
        export RCLONE_CONFIG_TEMPBOX_CRYPT_FILENAME_ENCRYPTION=standard
        export RCLONE_CONFIG_TEMPBOX_CRYPT_DIRECTORY_NAME_ENCRYPTION=true

        exclude_mount=()
        mount_path=${lib.escapeShellArg location}
        if [[ "$mount_path" == "$source_path"/* ]]; then
          mount_relative="''${mount_path#"$source_path"/}"
          exclude_mount=(--exclude "/$mount_relative/**")
          echo "Excluding mounted tempbox from source: $mount_relative" >&2
        fi

        exec rclone copy \
          --config="" \
          --progress \
          --transfers 8 \
          --checkers 16 \
          "''${exclude_mount[@]}" \
          "$@" \
          "$source_path" \
          "tempbox_crypt:$destination"
      '';
    })
  ];

  home.file.".ssh/tempbox_known_hosts".text = ''
    [${host}]:${toString port} ssh-rsa 
    [${host}]:${toString port} ecdsa-sha2-nistp521 AAAAE2VjZHNhLXNoYTItbmlzdHA1MjEAAAAIbmlzdHA1MjEAAACFBAGK0po6usux4Qv2d8zKZN1dDvbWjxKkGsx7XwFdSUCnF19Q8psHEUWR7C/LtSQ5crU/g+tQVRBtSgoUcE8T+FWp5wBxKvWG2X9gD+s9/4zRmDeSJR77W6gSA/+hpOZoSE+4KgNdnbYSNtbZH/dN74EG7GLb/gcIpbUUzPNXpfKl7mQitw==
    [${host}]:${toString port} ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIICf9svRenC/PLKIL9nk6K/pxQgoiFC41wTNvoIncOxs
  '';

  systemd.user.services.tempbox = {
    Unit = {
      Description = "Hetzner Storage Box encrypted mount";
      After = [ "network-online.target" ];
      Wants = [ "network-online.target" ];
    };

    Service = {
      Type = "notify";
      EnvironmentFile = config.sops.secrets.tempbox-rclone.path;
      Environment = [
        "RCLONE_CONFIG_TEMPBOX_SFTP_TYPE=sftp"
        "RCLONE_CONFIG_TEMPBOX_SFTP_HOST=${host}"
        "RCLONE_CONFIG_TEMPBOX_SFTP_USER=${user}"
        "RCLONE_CONFIG_TEMPBOX_SFTP_PORT=${toString port}"
        "RCLONE_CONFIG_TEMPBOX_SFTP_KEY_FILE=${config.home.homeDirectory}/.ssh/kamov"
        "RCLONE_CONFIG_TEMPBOX_SFTP_KNOWN_HOSTS_FILE=${config.home.homeDirectory}/.ssh/tempbox_known_hosts"
        "RCLONE_CONFIG_TEMPBOX_CRYPT_TYPE=crypt"
        "RCLONE_CONFIG_TEMPBOX_CRYPT_REMOTE=tempbox_sftp:crypt"
        "RCLONE_CONFIG_TEMPBOX_CRYPT_FILENAME_ENCRYPTION=standard"
        "RCLONE_CONFIG_TEMPBOX_CRYPT_DIRECTORY_NAME_ENCRYPTION=true"
      ];
      ExecStartPre = [
        "${pkgs.coreutils}/bin/mkdir -p ${location}"
        "${pkgs.coreutils}/bin/mkdir -p ${cache}"
      ];
      ExecStart = ''
        ${lib.getExe pkgs.rclone} mount tempbox_crypt: ${location} \
          --config="" \
          --cache-dir ${cache} \
          --vfs-cache-mode full \
          --vfs-cache-max-size 5G \
          --vfs-cache-max-age 4h \
          --vfs-cache-min-free-space 10G \
          --vfs-read-ahead 64M \
          --buffer-size 4M \
          --dir-cache-time 72h \
          --use-mmap
      '';
      ExecStop = "${pkgs.fuse3}/bin/fusermount3 -u -z ${location}";
      Restart = "on-failure";
      RestartSec = 30;
      TimeoutStopSec = 60;
    };

    Install.WantedBy = [ "default.target" ];
  };
}
